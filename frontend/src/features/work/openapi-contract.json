{
  "enums": {
    "MembershipRole": ["ADMIN", "MANAGER", "EMPLOYEE"],
    "TaskStatus": ["TO_DO", "IN_PROGRESS", "DONE"],
    "ApprovalDecision": ["APPROVE", "REJECT"],
    "ProjectWeekStatus": ["PLANNED", "ACTIVE", "COMPLETED"],
    "SkillEvidenceType": ["MANAGER_NOTE", "CERTIFICATE", "COMPLETED_TASK", "REVIEW_OUTCOME"]
  },
  "schemas": {
    "ProjectCreateRequest": { "required": ["name"], "properties": { "name": "string[1,160]", "description": "null|string[,5000]" } },
    "ProjectUpdateRequest": { "required": [], "properties": { "name": "null|string[1,160]", "description": "null|string[,5000]" } },
    "TaskCreateRequest": { "required": ["project_id", "project_week_id", "title", "estimated_effort_hours"], "properties": { "project_id": "string:uuid", "project_week_id": "string:uuid", "milestone_id": "null|string:uuid", "title": "string[1,200]", "description": "null|string[,10000]", "assignee_membership_id": "null|string:uuid", "required_skill_labels": "array:string", "estimated_effort_hours": "integer", "due_date": "null|string:date" } },
    "TaskUpdateRequest": { "required": [], "properties": { "title": "null|string[1,200]", "description": "null|string[,10000]", "assignee_membership_id": "null|string:uuid", "due_date": "null|string:date", "milestone_id": "null|string:uuid", "project_week_id": "null|string:uuid", "required_skill_labels": "array:string|null", "estimated_effort_hours": "integer|null" } },
    "TaskStatusRequest": { "required": ["to_status"], "properties": { "to_status": "enum:TaskStatus" } },
    "ProjectResponse": { "required": ["id", "name", "description", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "name": "string", "description": "null|string", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "ProjectPageResponse": { "required": ["items", "page", "page_size", "total"], "properties": { "items": "array:ref:ProjectResponse", "page": "integer", "page_size": "integer", "total": "integer" } },
    "MemberResponse": { "required": ["membership_id", "display_name", "role", "is_active"], "properties": { "membership_id": "string:uuid", "display_name": "string", "role": "enum:MembershipRole", "is_active": "boolean" } },
    "MemberPageResponse": { "required": ["items", "page", "page_size", "total"], "properties": { "items": "array:ref:MemberResponse", "page": "integer", "page_size": "integer", "total": "integer" } },
    "AssigneeResponse": { "required": ["membership_id", "display_name"], "properties": { "membership_id": "string:uuid", "display_name": "string" } },
    "TaskResponse": { "required": ["id", "project_id", "project_week_id", "milestone_id", "title", "description", "assignee", "required_skill_labels", "estimated_effort_hours", "status", "due_date", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "project_id": "string:uuid", "project_week_id": "null|string:uuid", "milestone_id": "null|string:uuid", "title": "string", "description": "null|string", "assignee": "null|ref:AssigneeResponse", "required_skill_labels": "array:string", "estimated_effort_hours": "integer|null", "status": "enum:TaskStatus", "due_date": "null|string:date", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "TaskPageResponse": { "required": ["items", "page", "page_size", "total"], "properties": { "items": "array:ref:TaskResponse", "page": "integer", "page_size": "integer", "total": "integer" } },
    "GoalCreateRequest": { "required": ["project_id", "title"], "properties": { "project_id": "string:uuid", "title": "string[1,200]", "description": "null|string[,5000]", "expected_outcomes": "array:string", "target_date": "null|string:date" } },
    "GoalUpdateRequest": { "required": [], "properties": { "title": "null|string[1,200]", "description": "null|string[,5000]", "expected_outcomes": "array:string|null", "target_date": "null|string:date" } },
    "GoalResponse": { "required": ["id", "project_id", "title", "description", "expected_outcomes", "target_date", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "project_id": "string:uuid", "title": "string", "description": "null|string", "expected_outcomes": "array:string", "target_date": "null|string:date", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "MilestoneCreateRequest": { "required": ["project_id", "name", "position"], "properties": { "project_id": "string:uuid", "name": "string[1,200]", "description": "null|string[,5000]", "target_date": "null|string:date", "position": "integer" } },
    "MilestoneUpdateRequest": { "required": [], "properties": { "name": "null|string[1,200]", "description": "null|string[,5000]", "target_date": "null|string:date", "position": "integer|null" } },
    "MilestoneResponse": { "required": ["id", "project_id", "name", "description", "target_date", "position", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "project_id": "string:uuid", "name": "string", "description": "null|string", "target_date": "null|string:date", "position": "integer", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "ProjectWeekCreateRequest": { "required": ["week_number", "start_date", "end_date", "objective"], "properties": { "week_number": "integer", "start_date": "string:date", "end_date": "string:date", "objective": "string[1,2000]", "status": "enum:ProjectWeekStatus" } },
    "ProjectWeekUpdateRequest": { "required": [], "properties": { "week_number": "integer|null", "start_date": "null|string:date", "end_date": "null|string:date", "objective": "null|string[1,2000]", "status": "enum:ProjectWeekStatus|null" } },
    "ProjectWeekResponse": { "required": ["id", "project_id", "week_number", "start_date", "end_date", "objective", "status", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "project_id": "string:uuid", "week_number": "integer", "start_date": "string:date", "end_date": "string:date", "objective": "string", "status": "enum:ProjectWeekStatus", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "DependencyCreateRequest": { "required": ["predecessor_task_id", "successor_task_id"], "properties": { "predecessor_task_id": "string:uuid", "successor_task_id": "string:uuid" } },
    "DependencyUpdateRequest": { "required": [], "properties": { "predecessor_task_id": "null|string:uuid", "successor_task_id": "null|string:uuid" } },
    "DependencyResponse": { "required": ["id", "predecessor_task_id", "successor_task_id", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "predecessor_task_id": "string:uuid", "successor_task_id": "string:uuid", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "AcceptanceCriterionCreateRequest": { "required": ["task_id", "text", "position"], "properties": { "task_id": "string:uuid", "text": "string[1,1000]", "position": "integer" } },
    "AcceptanceCriterionUpdateRequest": { "required": [], "properties": { "text": "null|string[1,1000]", "position": "integer|null" } },
    "AcceptanceCriterionResponse": { "required": ["id", "task_id", "text", "position", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "task_id": "string:uuid", "text": "string", "position": "integer", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "PlanningPageResponse": { "required": ["items", "page", "page_size", "total"], "properties": { "items": "array:ref:AcceptanceCriterionResponse|ref:DependencyResponse|ref:GoalResponse|ref:MilestoneResponse|ref:ProjectWeekResponse", "page": "integer", "page_size": "integer", "total": "integer" } },
    "DeleteResponse": { "required": ["id", "version"], "properties": { "id": "string:uuid", "version": "integer" } },
    "WorkflowRunReferenceResponse": { "required": ["run_id", "status", "version"], "properties": { "run_id": "string:uuid", "status": "string", "version": "integer" } },
    "PreviousProposalVersionResponse": { "required": ["version", "content", "field_provenance", "creator_type"], "properties": { "version": "integer", "content": "object", "field_provenance": "object", "creator_type": "string" } },
    "WorkflowProposalSnapshotResponse": { "required": ["proposal_id", "approval_id", "status", "version", "validation_result", "content", "change_summary", "field_provenance", "creator_type", "previous_version"], "properties": { "proposal_id": "string:uuid", "approval_id": "null|string:uuid", "status": "string", "version": "integer", "validation_result": "object", "content": "object", "change_summary": "null|string", "field_provenance": "object", "creator_type": "string", "previous_version": "null|ref:PreviousProposalVersionResponse" } },
    "WorkflowRunResponse": { "required": ["id", "project_id", "status", "workflow_name", "workflow_version", "verifier_version", "input_goal_text", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "project_id": "null|string:uuid", "status": "string", "workflow_name": "string", "workflow_version": "string", "verifier_version": "string", "input_goal_text": "string", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time", "current_stage": "null|string", "current_proposal": "null|ref:WorkflowProposalSnapshotResponse", "public_timeline": "array:ref:WorkflowTimelineItemResponse", "allowed_actions": "array:string" } },
    "ApprovalDecisionResponse": { "required": ["approval", "proposal", "created", "workflow_run_id", "finalization_job_id"], "properties": { "approval": "ref:ApprovalStatusResponse", "proposal": "ref:DecidedProposalResponse", "created": "ref:CreatedBusinessIdsResponse", "workflow_run_id": "string:uuid", "finalization_job_id": "string:uuid" } },
    "FieldError": { "required": ["field", "code", "message_key"], "properties": { "field": "string", "code": "string", "message_key": "string" } },
    "ErrorDetail": { "required": ["code", "message_key", "request_id"], "properties": { "code": "string", "message_key": "string", "request_id": "string", "field_errors": "array:ref:FieldError", "details": "object" } },
    "ErrorResponse": { "required": ["error"], "properties": { "error": "ref:ErrorDetail" } },
    "SkillCreateRequest": { "required": ["name"], "properties": { "name": "string[1,100]", "description": "null|string[,2000]" } },
    "SkillUpdateRequest": { "required": [], "properties": { "name": "null|string[1,100]", "description": "null|string[,2000]", "active": "boolean|null" } },
    "SkillResponse": { "required": ["id", "organization_id", "name", "normalized_name", "description", "active", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "organization_id": "string:uuid", "name": "string", "normalized_name": "string", "description": "null|string", "active": "boolean", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "SkillEvidenceCreateRequest": { "required": ["evidence_type", "summary", "source_resource_type", "source_resource_id", "occurred_at"], "properties": { "evidence_type": "enum:SkillEvidenceType", "summary": "string[1,2000]", "source_resource_type": "string[1,100]", "source_resource_id": "string:uuid", "occurred_at": "string:date-time" } },
    "SkillEvidenceResponse": { "required": ["id", "organization_id", "person_skill_id", "evidence_type", "summary", "source_resource_type", "source_resource_id", "occurred_at", "created_by_membership_id", "created_at"], "properties": { "id": "string:uuid", "organization_id": "string:uuid", "person_skill_id": "string:uuid", "evidence_type": "enum:SkillEvidenceType", "summary": "string", "source_resource_type": "string", "source_resource_id": "string:uuid", "occurred_at": "string:date-time", "created_by_membership_id": "string:uuid", "created_at": "string:date-time" } },
    "PersonSkillUpsertRequest": { "required": ["skill_id", "level"], "properties": { "skill_id": "string:uuid", "level": "integer", "evidence": "array:ref:SkillEvidenceCreateRequest" } },
    "PersonSkillResponse": { "required": ["id", "organization_id", "membership_id", "skill_id", "level", "verified_by_membership_id", "verified_at", "version", "created_at", "updated_at", "active", "evidence"], "properties": { "id": "string:uuid", "organization_id": "string:uuid", "membership_id": "string:uuid", "skill_id": "string:uuid", "level": "integer", "verified_by_membership_id": "string:uuid", "verified_at": "string:date-time", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time", "active": "boolean", "evidence": "array:ref:SkillEvidenceResponse" } },
    "WorkOutcomeEvidenceCreateRequest": { "required": ["evidence_type", "summary", "source_resource_type", "source_resource_id", "source_resource_version", "observed_at"], "properties": { "evidence_type": "enum:SkillEvidenceType", "summary": "string[1,2000]", "source_resource_type": "string[1,100]", "source_resource_id": "string:uuid", "source_resource_version": "integer", "observed_at": "string:date-time" } },
    "WorkOutcomeEvidenceResponse": { "required": ["id", "organization_id", "membership_id", "evidence_type", "summary", "source_resource_type", "source_resource_id", "source_resource_version", "observed_at", "created_by_membership_id", "created_at"], "properties": { "id": "string:uuid", "organization_id": "string:uuid", "membership_id": "string:uuid", "evidence_type": "enum:SkillEvidenceType", "summary": "string", "source_resource_type": "string", "source_resource_id": "string:uuid", "source_resource_version": "integer", "observed_at": "string:date-time", "created_by_membership_id": "string:uuid", "created_at": "string:date-time" } }
  },
  "people_capacity": {
    "paths": {
      "/api/v1/skills": ["get", "post"],
      "/api/v1/skills/{skill_id}": ["get", "patch", "delete"],
      "/api/v1/members/{membership_id}/skills": ["get"],
      "/api/v1/members/{membership_id}/skills/{skill_id}": ["get", "put", "delete"],
      "/api/v1/members/{membership_id}/work-evidence": ["get", "post"]
    }
  },
  "assistant": {
    "paths": {
      "/api/v1/ai/conversations": ["get", "post"],
      "/api/v1/ai/conversations/{conversation_id}": ["get"],
      "/api/v1/ai/conversations/{conversation_id}/messages": ["post"],
      "/api/v1/ai/conversations/{conversation_id}/events": ["get"]
    },
    "content_block_mapping": {
      "activity": "#/components/schemas/ActivityBlock",
      "capability_unavailable": "#/components/schemas/CapabilityUnavailableBlock",
      "decision_result": "#/components/schemas/DecisionResultBlock",
      "planning_run": "#/components/schemas/PlanningRunBlock",
      "proposal": "#/components/schemas/ProposalBlock",
      "question": "#/components/schemas/QuestionBlock",
      "safe_error": "#/components/schemas/SafeErrorBlock",
      "text": "#/components/schemas/TextBlock",
      "work_evidence": "#/components/schemas/WorkEvidenceBlock"
    },
    "schemas": {
      "CreateConversationRequest": { "required": ["locale"], "properties": { "locale": "literal:vi|en", "title": "null|string[,120]" } },
      "ConversationResponse": { "required": ["id", "locale", "title", "status", "last_message_sequence", "last_event_sequence", "created_at", "updated_at"], "properties": { "id": "string:uuid", "locale": "literal:vi|en", "title": "null|string", "status": "string", "last_message_sequence": "integer", "last_event_sequence": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
      "ConversationListResponse": { "required": ["items"], "properties": { "items": "array:ref:ConversationResponse" } },
      "PostAssistantMessageRequest": { "required": ["message", "locale"], "properties": { "message": "string[1,8000]", "locale": "literal:vi|en", "card_action": "null|ref:CardAction" } },
      "AssistantTurnAcceptedResponse": { "required": ["conversation_id", "message_id", "turn_id", "orchestration_run_id", "status"], "properties": { "conversation_id": "string:uuid", "message_id": "string:uuid", "turn_id": "string:uuid", "orchestration_run_id": "string:uuid", "status": "literal:QUEUED" } },
      "ConversationSnapshotResponse": { "required": ["conversation", "messages"], "properties": { "conversation": "ref:ConversationResponse", "messages": "array:ref:MessageResponse" } }
    }
  }
}
