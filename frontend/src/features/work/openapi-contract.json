{
  "enums": {
    "MembershipRole": ["ADMIN", "MANAGER", "EMPLOYEE"],
    "TaskStatus": ["TO_DO", "IN_PROGRESS", "DONE"]
  },
  "schemas": {
    "ProjectCreateRequest": { "required": ["name"], "properties": { "name": "string[1,160]", "description": "null|string[,5000]" } },
    "ProjectUpdateRequest": { "required": [], "properties": { "name": "null|string[1,160]", "description": "null|string[,5000]" } },
    "TaskCreateRequest": { "required": ["project_id", "title", "assignee_membership_id"], "properties": { "project_id": "string:uuid", "milestone_id": "null|string:uuid", "title": "string[1,200]", "description": "null|string[,10000]", "assignee_membership_id": "string:uuid", "due_date": "null|string:date" } },
    "TaskUpdateRequest": { "required": [], "properties": { "title": "null|string[1,200]", "description": "null|string[,10000]", "assignee_membership_id": "null|string:uuid", "due_date": "null|string:date", "milestone_id": "null|string:uuid" } },
    "TaskStatusRequest": { "required": ["to_status"], "properties": { "to_status": "enum:TaskStatus" } },
    "ProjectResponse": { "required": ["id", "name", "description", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "name": "string", "description": "null|string", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "ProjectPageResponse": { "required": ["items", "page", "page_size", "total"], "properties": { "items": "array:ref:ProjectResponse", "page": "integer", "page_size": "integer", "total": "integer" } },
    "MemberResponse": { "required": ["membership_id", "display_name", "role", "is_active"], "properties": { "membership_id": "string:uuid", "display_name": "string", "role": "enum:MembershipRole", "is_active": "boolean" } },
    "MemberPageResponse": { "required": ["items", "page", "page_size", "total"], "properties": { "items": "array:ref:MemberResponse", "page": "integer", "page_size": "integer", "total": "integer" } },
    "AssigneeResponse": { "required": ["membership_id", "display_name"], "properties": { "membership_id": "string:uuid", "display_name": "string" } },
    "TaskResponse": { "required": ["id", "project_id", "milestone_id", "title", "description", "assignee", "status", "due_date", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "project_id": "string:uuid", "milestone_id": "null|string:uuid", "title": "string", "description": "null|string", "assignee": "ref:AssigneeResponse", "status": "enum:TaskStatus", "due_date": "null|string:date", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "TaskPageResponse": { "required": ["items", "page", "page_size", "total"], "properties": { "items": "array:ref:TaskResponse", "page": "integer", "page_size": "integer", "total": "integer" } },
    "GoalCreateRequest": { "required": ["project_id", "title"], "properties": { "project_id": "string:uuid", "title": "string[1,200]", "description": "null|string[,5000]", "expected_outcomes": "array:string", "target_date": "null|string:date" } },
    "GoalUpdateRequest": { "required": [], "properties": { "title": "null|string[1,200]", "description": "null|string[,5000]", "expected_outcomes": "array:string|null", "target_date": "null|string:date" } },
    "GoalResponse": { "required": ["id", "project_id", "title", "description", "expected_outcomes", "target_date", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "project_id": "string:uuid", "title": "string", "description": "null|string", "expected_outcomes": "array:string", "target_date": "null|string:date", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "MilestoneCreateRequest": { "required": ["project_id", "name", "position"], "properties": { "project_id": "string:uuid", "name": "string[1,200]", "description": "null|string[,5000]", "target_date": "null|string:date", "position": "integer" } },
    "MilestoneUpdateRequest": { "required": [], "properties": { "name": "null|string[1,200]", "description": "null|string[,5000]", "target_date": "null|string:date", "position": "integer|null" } },
    "MilestoneResponse": { "required": ["id", "project_id", "name", "description", "target_date", "position", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "project_id": "string:uuid", "name": "string", "description": "null|string", "target_date": "null|string:date", "position": "integer", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "DependencyCreateRequest": { "required": ["predecessor_task_id", "successor_task_id"], "properties": { "predecessor_task_id": "string:uuid", "successor_task_id": "string:uuid" } },
    "DependencyUpdateRequest": { "required": [], "properties": { "predecessor_task_id": "null|string:uuid", "successor_task_id": "null|string:uuid" } },
    "DependencyResponse": { "required": ["id", "predecessor_task_id", "successor_task_id", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "predecessor_task_id": "string:uuid", "successor_task_id": "string:uuid", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "AcceptanceCriterionCreateRequest": { "required": ["task_id", "text", "position"], "properties": { "task_id": "string:uuid", "text": "string[1,1000]", "position": "integer" } },
    "AcceptanceCriterionUpdateRequest": { "required": [], "properties": { "text": "null|string[1,1000]", "position": "integer|null" } },
    "AcceptanceCriterionResponse": { "required": ["id", "task_id", "text", "position", "version", "created_at", "updated_at"], "properties": { "id": "string:uuid", "task_id": "string:uuid", "text": "string", "position": "integer", "version": "integer", "created_at": "string:date-time", "updated_at": "string:date-time" } },
    "PlanningPageResponse": { "required": ["items", "page", "page_size", "total"], "properties": { "items": "array:ref:AcceptanceCriterionResponse|ref:DependencyResponse|ref:GoalResponse|ref:MilestoneResponse", "page": "integer", "page_size": "integer", "total": "integer" } },
    "DeleteResponse": { "required": ["id", "version"], "properties": { "id": "string:uuid", "version": "integer" } },
    "FieldError": { "required": ["field", "code", "message_key"], "properties": { "field": "string", "code": "string", "message_key": "string" } },
    "ErrorDetail": { "required": ["code", "message_key", "request_id"], "properties": { "code": "string", "message_key": "string", "request_id": "string", "field_errors": "array:ref:FieldError", "details": "object" } },
    "ErrorResponse": { "required": ["error"], "properties": { "error": "ref:ErrorDetail" } }
  }
}
